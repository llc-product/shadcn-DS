{
  "name": "@digitaltwin/auth",
  "version": "0.1.0",
  "description": "Cookie-only JWT auth: runtime-agnostic core plus a Next adapter",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@digitaltwin/constants": "^0.1.0",
    "jose": "^6.2.12"
  },
  "peerDependencies": {
    "next": "^16",
    "server-only": "*"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "server-only": {
      "optional": true
    }
  },
  "devDependencies": {
    "@digitaltwin/tsconfig": "*",
    "next": "^16.3.4",
    "server-only": "^0.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
