{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    // Beyond `strict`. A design system is consumed by every app, so its type surface should model
    // the strictest settings that are livable. noUncheckedIndexedAccess is the one that catches
    // real bugs — arr[0] and record[key] are typed as possibly undefined, which they genuinely are.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true
  }
}
